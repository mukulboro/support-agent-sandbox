# Copy this file to .env and fill in the key. .env is gitignored: never commit it.
OPENAI_API_KEY=

# Everything below is optional. The defaults are in app/config.py; uncomment a line to override it.

# Models
# LLM_MODEL=gpt-5-nano            # static and dynamic agents
# ROUTER_MODEL=gpt-5-mini         # router
# AUDITOR_MODEL=gpt-5-mini        # auditor
# EMBED_MODEL=text-embedding-3-small

# Retrieval
# CHUNKS_TO_FETCH=12              # chunks pulled from Qdrant per question
# SECTIONS_TO_RETURN=6            # help-article sections handed to the static agent

# Agent behaviour
# TODAY=2026-09-28                # the mock dataset is built as though this is today
# MAX_TOOL_ROUNDS=6               # tool-call rounds the dynamic agent may use per question
# LLM_RETRIES=3

# Storage. docker compose sets these itself; leave QDRANT_URL empty to use an in-memory Qdrant when running without Docker.
# QDRANT_URL=http://localhost:6333
# DB_PATH=audit.db